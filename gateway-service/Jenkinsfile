pipeline {
agent any

options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '10'))
    timeout(time: 30, unit: 'MINUTES')
    disableConcurrentBuilds()
}

environment {
    HARBOR_REGISTRY = '192.168.100.10:8080'
    HARBOR_PROJECT  = 'etrade'
    IMAGE_NAME      = 'gateway-service'
    IMAGE_REPO      = "${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${IMAGE_NAME}"
    HARBOR_CREDS    = 'harbor-credentials'
}

stages {
    stage('Checkout') {
        steps {
            checkout scm
            sh 'git log -1 --oneline'
            script {
                env.GIT_SHORT = sh(
                    script: 'git rev-parse --short=7 HEAD',
                    returnStdout: true
                ).trim()

                env.IMAGE_TAG = "1.0.0-${env.GIT_SHORT}"
            }
            echo "Tag image : ${env.IMAGE_TAG}"
        }
    }

    stage('Maven Build') {
        steps {
            sh 'mvn -B -pl gateway-service -am clean package -DskipTests'
        }
    }

    stage('SonarQube Analysis') {
        steps {
            withSonarQubeEnv('SonarQube') {
                sh """
                    mvn -B -pl gateway-service -am \
                      org.sonarsource.scanner.maven:sonar-maven-plugin:4.0.0.4121:sonar \
                      -Dsonar.projectKey=etrade-gateway-service \
                      -Dsonar.projectName='eTrade Gateway Service'
                """
            }
        }
    }

    stage('Docker Build') {
        steps {
            sh """
                docker build \
                  -f gateway-service/Dockerfile \
                  -t ${IMAGE_REPO}:${IMAGE_TAG} \
                  -t ${IMAGE_REPO}:latest \
                  .
            """
        }
    }

    stage('Docker Push') {
        steps {
            withCredentials([usernamePassword(
                credentialsId: "${HARBOR_CREDS}",
                usernameVariable: 'HARBOR_USER',
                passwordVariable: 'HARBOR_PASS'
            )]) {
                sh """
                    echo "\$HARBOR_PASS" | docker login ${HARBOR_REGISTRY} \
                      -u "\$HARBOR_USER" --password-stdin

                    docker push ${IMAGE_REPO}:${IMAGE_TAG}
                    docker push ${IMAGE_REPO}:latest

                    docker logout ${HARBOR_REGISTRY}
                """
            }
        }
    }

    stage('Cleanup') {
        steps {
            sh """
                docker rmi ${IMAGE_REPO}:${IMAGE_TAG} || true
                docker rmi ${IMAGE_REPO}:latest || true
                docker image prune -f
            """
        }
    }
}

post {
    success {
        echo "✅ gateway-service poussé : ${IMAGE_REPO}:${IMAGE_TAG} + :latest"
    }
    failure {
        echo "❌ Pipeline gateway-service en échec."
    }
    always {
        cleanWs()
    }
}

}

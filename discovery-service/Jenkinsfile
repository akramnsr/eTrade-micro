pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        HARBOR_REGISTRY = '192.168.100.10:8080'
        HARBOR_PROJECT  = 'etrade'
        IMAGE_NAME      = 'discovery-service'
        IMAGE_REPO      = "${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${IMAGE_NAME}"
        HARBOR_CREDS    = 'harbor-credentials'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_SHORT = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.IMAGE_TAG = "1.0.0-${env.GIT_SHORT}"
                }
                echo "Tag image : ${env.IMAGE_TAG}"
            }
        }

        stage('Maven Build') {
            steps {
                sh 'chmod +x mvnw'
                sh './mvnw -B -pl discovery-service -am clean package -DskipTests'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh '''
                        ./mvnw -B -pl discovery-service sonar:sonar \
                          -Dsonar.projectKey=etrade-discovery-service \
                          -Dsonar.projectName=discovery-service
                    '''
                }
            }
        }

        stage('Verify JAR') {
            steps {
                sh 'ls -lh discovery-service/target/discovery-service-*.jar'
            }
        }

        stage('Docker Build') {
            steps {
                sh """
                    docker build \
                      -f discovery-service/Dockerfile \
                      -t ${IMAGE_REPO}:${IMAGE_TAG} \
                      -t ${IMAGE_REPO}:latest \
                      .
                """
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(
                        credentialsId: "${HARBOR_CREDS}",
                        usernameVariable: 'HARBOR_USER',
                        passwordVariable: 'HARBOR_PASS')]) {
                    sh """
                        echo "\$HARBOR_PASS" | docker login ${HARBOR_REGISTRY} -u "\$HARBOR_USER" --password-stdin
                        docker push ${IMAGE_REPO}:${IMAGE_TAG}
                        docker push ${IMAGE_REPO}:latest
                        docker logout ${HARBOR_REGISTRY}
                    """
                }
            }
        }

        stage('Cleanup') {
            steps {
                sh """
                    docker rmi ${IMAGE_REPO}:${IMAGE_TAG} || true
                    docker rmi ${IMAGE_REPO}:latest || true
                """
            }
        }
    }

    post {
        success {
            echo "✅ discovery-service poussé : ${IMAGE_REPO}:${IMAGE_TAG} + :latest"
        }
        failure {
            echo "❌ Pipeline discovery-service en échec."
        }
    }
}
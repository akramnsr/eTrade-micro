# ===========================================================
#  .dockerignore — racine du monorepo etrade-backend
#  Dockerfile (runtime-only) -> COPY <service>/target/<service>-*.jar /app/app.jar
#  REGLE D'OR : ne JAMAIS exclure le DOSSIER target (**/target/),
#  sinon Docker n'y descend pas et !**/target/*.jar est ignore.
#  On exclut le CONTENU (**/target/*), puis on re-inclut les JAR.
# ===========================================================

# Git
.git
.gitignore

# IDE
**/.idea
**/*.iml
**/*.iws
**/*.ipr
.vscode
.settings
.project
.classpath

# Secrets / env
**/.env
**/.env.*

# Frontend (inutile pour les images backend)
frontend

# Sources Java (les images ne copient que le JAR final)
**/src

# Maven wrapper / divers
**/.mvn
**/mvnw
**/mvnw.cmd
HELP.md

# --- Contenu des target/ exclu, mais on GARDE le JAR final ---
**/target/*
!**/target/*.jar